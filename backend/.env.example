# Copy this file to .env and fill in real values

# Database - defaults to local SQLite file, no setup needed.
# For Postgres (used by docker-compose): postgresql://postgres:postgres@db:5432/diagramstudio
DATABASE_URL=sqlite:///./diagramstudio.db

# Secret used to sign JWT auth tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional. If set, the AI Clean Up feature uses Anthropic's API for
# real diagram interpretation. If left blank, a built-in geometric
# shape-recognition fallback is used instead (still fully functional,
# just less "understanding" of intent).
ANTHROPIC_API_KEY=

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
